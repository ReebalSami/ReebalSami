{
  "name": "reebalsami-profile",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub profile README assets and milestone generation for @ReebalSami.",
  "type": "module",
  "scripts": {
    "milestones": "node scripts/generate-milestones.mjs",
    "numbers": "node scripts/generate-github-numbers.mjs",
    "hero": "node scripts/generate-hero.mjs",
    "tech-stack": "node scripts/generate-tech-stack.mjs",
    "build": "node scripts/build-calendar.mjs --user ReebalSami --weeks 26 --out assets/metrics.svg",
    "build:fixture": "node scripts/build-calendar.mjs --fixture --out tmp/fixture.svg",
    "test": "node scripts/test-build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.1"
  }
}
